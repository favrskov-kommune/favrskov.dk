<?php

use Drupal\Core\Url;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\file\Entity\File;
use Drupal\node\Entity\Node;

function favrskov_preprocess_block__inline_block__inline_navigation(array &$variables) {

  /** @var \Drupal\block_content\Entity\BlockContent $block */
  $block = $variables['elements']['content']['#block_content'];
  $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
  $block_view_mode = $block->get('field_variant')->value;
  $rendered_content = [];

  $links = [];
  if ($block->hasField('field_link_list') && !$block->get('field_link_list')->isEmpty()) {
    $block_link_list = $block->get('field_link_list')->entity->get('field_links');
    $block_link_list_name = $block->get('field_link_list')->entity->get('name')->value;
    $links['name'] = $block_link_list_name;
    foreach ($block_link_list as $item) {
      $data = $item->getValue();
      $links['items'][] = [
        'title' => $data['title'],
        'url' => Url::fromUri($data['uri'])->toString(),
        'target' => $data['target_blank']
      ];
    }
    $variables['link_list'] = $links;
  }

  foreach ($variables['content'] as $value) {
    $rendered_content[] = $view_builder->view($value['#node'], $block_view_mode);
  }

  $variables['is_slider'] = $block_view_mode === 'inline_navigation_campaign';
  $variables['content'] = $rendered_content;

  if ($block_view_mode === 'inline_navigation') {
    $variables['attributes']['class'][] = 'inline-navigation-image';
  } elseif ($block_view_mode === 'inline_navigation_campaign') {
    $variables['attributes']['class'][] = 'inline-navigation-campaign';
  } else {
    $variables['attributes']['class'][] = $block_view_mode;
  }
}

function favrskov_preprocess_block__inline_block__document_list(array &$variables) {
  /** @var \Drupal\block_content\Entity\BlockContent $block */
  $block = $variables['elements']['content']['#block_content'];
  $links = [];
  if ($block->hasField('field_media_documents') && !$block->get('field_media_documents')->isEmpty()) {
    /** @var \Drupal\media\Entity\Media $item */
    foreach ($block->get('field_media_documents') as $item) {
      $item = $item->entity;
      if (!empty($item)) {
        $links[] = [
          'title' => $item->label(),
          'url' => File::load($item->field_media_document->entity->fid->value)->createFileUrl(FALSE),
        ];
      }
    }
  }
  if ($block->hasField('field_links') && !$block->get('field_links')->isEmpty()) {
    /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem $item */
    foreach ($block->get('field_links') as $item) {
      $data = $item->getValue();
      if (!empty($data)) {
        $links[] = [
          'title' => $data['title'],
          'url' => $data['uri']
        ];
      }
    }
  }

  if (!empty($links)) {
    foreach ($links as $link) {
      $variables['links'][] = [
        'title' => $link['title'],
        'url' => Url::fromUri($link['url'])->toString(),
        'icon' => 'document',
      ];
    }
  }
}

function favrskov_preprocess_block__inline_block__branding_spot(array &$variables) {
  /** @var \Drupal\block_content\Entity\BlockContent $block */
  $block = $variables['elements']['content']['#block_content'];
  $links = [];
  if ($block->hasField('field_branding_spot_title') && !$block->get('field_branding_spot_title')->isEmpty()) {
    $variables['branding_spot_title'] = $block->get('field_branding_spot_title')->value;
  }
  if ($block->hasField('field_branding_spot_subline') && !$block->get('field_branding_spot_subline')->isEmpty()) {
    $variables['branding_spot_subline'] = $block->get('field_branding_spot_subline')->value;
  }
  if ($block->hasField('field_links') && !$block->get('field_links')->isEmpty()) {
    /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem $item */
    foreach ($block->get('field_links') as $item) {
      $data = $item->getValue();
      if (!empty($data)) {
        $links[] = [
          'title' => $data['title'],
          'url' => $data['uri']
        ];
      }
    }
  }

  if (!empty($links)) {
    foreach ($links as $link) {
      $variables['branding_spot_links'][] = [
        'title' => $link['title'],
        'url' => Url::fromUri($link['url'])->toString(),
        'icon' => 'document',
      ];
    }
  }
}

/**
 * Change hero paragraph, add media and page title.
 *
 * @param array $variables
 *   Theme variables.
 */
function favrskov_preprocess_paragraph__basic_hero(array &$variables) {
  $variables['is_front_page_header'] = \Drupal::service('path.matcher')->isFrontPage();
}

/**
 * Contact layout block preprocess.
 *
 * @param array $variables
 *   Template variables.
 */
function favrskov_preprocess_block__inline_block__contact(array &$variables) {
  /** @var \Drupal\block_content\Entity\BlockContent $block */
  $block = $variables['elements']['content']['#block_content'];
  $layout = $variables['elements']['content']['#layout'] ?? [];
  $layout_id = $layout['layout_id'] ?? '';

  if ($block->hasField('field_cta') && !$block->get('field_cta')->isEmpty()) {
    try {
      $button = $block->get('field_cta')->first();

      if (!is_null($button)) {
        $button = $button->getValue();

        if (isset($button['uri'], $button['title'])) {
          $variables['link']['title'] = $button['title'];
          $variables['link']['url'] = Url::fromUri($button['uri'])->toString();

          if (isset($button['target_blank']) && (int) $button['target_blank'] === 1) {
            $variables['link']['target'] = '_blank';
          }
        }
      }
    }
    catch (MissingDataException $e) {
      Drupal::logger('premium_theme')->error($e->getMessage());
    }
  }
  if ($layout_id === 'layout_onecol') {
    $variables['is_onecol'] = TRUE;
  }

}


/**
 * Slideshow layout block preprocess.
 *
 * @param array $variables
 *   Template variables.
 */
function favrskov_preprocess_block__inline_block__slideshow(array &$variables) {
  /** @var \Drupal\block_content\Entity\BlockContent $block */
  $block = $variables['elements']['content']['#block_content'];
  $variables['items'] = [];

  if ($block->hasField('field_slideshow_images') && !$block->get('field_slideshow_images')->isEmpty()) {
    $medias = $block->get('field_slideshow_images')->referencedEntities();
    $media_view_builder = \Drupal::entityTypeManager()->getViewBuilder('media');

    if (!empty($medias)) {
      foreach ($medias as $media) {
        $variables['items'][] = ['image' => $media_view_builder->view($media, 'slideshow')];
      }
    }
  }
}

/**
 * Format a standalone timeline month and year with an initial capital.
 */
function favrskov_timeline_date_label(?string $date): string {
  if (!$date) {
    return '';
  }

  $timestamp = (new \DateTimeImmutable($date, new \DateTimeZone('UTC')))->getTimestamp();
  $label = \Drupal::service('date.formatter')->format($timestamp, 'custom', 'F Y', 'UTC');
  return ucfirst($label);
}

/**
 * Prepare the date navigation for a timeline block.
 */
function favrskov_preprocess_block__inline_block__timeline(array &$variables) {
  /** @var \Drupal\block_content\Entity\BlockContent $block */
  $block = $variables['elements']['content']['#block_content'];
  $variables['timeline_title'] = $block->get('field_headline')->value;
  $variables['timeline_has_intro'] = !$block->get('field_text')->isEmpty();
  $variables['timeline_layout'] = $block->get('field_timeline_layout')->value === 'vertical' ? 'vertical' : 'horizontal';
  $variables['timeline_nav'] = [];
  $variables['timeline_statuses'] = [];
  $seen_statuses = [];
  foreach ($block->get('field_timeline_cards')->referencedEntities() as $delta => $card) {
    $date = $card->get('field_timeline_date')->value;
    $variables['timeline_nav'][] = [
      'id' => 'timeline-' . $block->uuid() . '-card-' . $delta,
      'date' => $date ? favrskov_timeline_date_label($date) : (string) t('Date pending'),
      'title' => $card->get('field_title')->value,
    ];

    $term = $card->get('field_timeline_status')->entity;
    if (!$term) {
      continue;
    }

    $access = $term->access('view', NULL, TRUE);
    CacheableMetadata::createFromObject($access)->applyTo($variables['content']);
    if (!$access->isAllowed() || isset($seen_statuses[$term->id()])) {
      continue;
    }
    $seen_statuses[$term->id()] = TRUE;

    $background = $term->get('field_status_background_color')->value;
    $text_color = $term->get('field_status_text_color')->value;
    $background = $background && preg_match('/^#[0-9a-fA-F]{6}$/', $background) ? $background : '';
    $text_color = $text_color && preg_match('/^#[0-9a-fA-F]{6}$/', $text_color) ? $text_color : '';
    $outlined = $background && strcasecmp($background, '#FFFFFF') === 0 && $text_color;
    $variables['timeline_statuses'][] = [
      'label' => $term->label(),
      'color' => $outlined ? $text_color : $background,
      'outlined' => (bool) $outlined,
    ];
    CacheableMetadata::createFromObject($term)->applyTo($variables['content']);
  }
}

/**
 * Give timeline cards stable targets for the vertical date navigation.
 */
function favrskov_preprocess_field__field_timeline_cards(array &$variables) {
  $block = $variables['element']['#object'] ?? NULL;
  if (!$block || $block->getEntityTypeId() !== 'block_content' || $block->bundle() !== 'timeline') {
    return;
  }

  foreach ($variables['items'] as $delta => &$item) {
    $item['timeline_anchor'] = 'timeline-' . $block->uuid() . '-card-' . $delta;
    $item['timeline_status_color'] = '';

    $card = $block->get('field_timeline_cards')->get($delta)->entity;
    $term = $card ? $card->get('field_timeline_status')->entity : NULL;
    if (!$term || !$term->access('view')) {
      continue;
    }

    $color = $term->get('field_status_background_color')->value;
    if ($color && preg_match('/^#[0-9a-fA-F]{6}$/', $color)) {
      $item['timeline_status_color'] = $color;
      CacheableMetadata::createFromObject($term)->applyTo($item['content']);
    }
  }
}

/**
 * Style content card CTA links as buttons.
 */
function favrskov_preprocess_field__field_cta(array &$variables) {
  $entity = $variables['element']['#object'] ?? NULL;
  if (!$entity || $entity->getEntityTypeId() !== 'paragraph' || $entity->bundle() !== 'content_card') {
    return;
  }

  foreach ($variables['items'] as &$item) {
    if (($item['content']['#theme'] ?? NULL) === 'link_with_target') {
      $item['content']['#theme'] = 'link_with_target__timeline_card';
    }
  }
}

/**
 * Keep editor-supplied status colours safe for use in CSS custom properties.
 */
function favrskov_preprocess_paragraph__content_card(array &$variables) {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['card_text_id'] = 'timeline-card-text-' . $paragraph->uuid();
  $variables['card_title'] = $paragraph->get('field_title')->value;
  $variables['card_date'] = favrskov_timeline_date_label($paragraph->get('field_timeline_date')->value);
  $variables['card_type'] = $paragraph->get('field_timeline_type')->value;
  $variables['card_has_image'] = !$paragraph->get('field_image')->isEmpty();
  $variables['card_has_text'] = !$paragraph->get('field_text')->isEmpty();
  $variables['card_has_link'] = !$paragraph->get('field_cta')->isEmpty();
  $variables['card_has_status'] = FALSE;
  $variables['status_style'] = '';

  $term = $paragraph->get('field_timeline_status')->entity;
  if (!$term || !$term->access('view')) {
    return;
  }
  $variables['card_has_status'] = TRUE;

  $styles = [];
  foreach (['background' => '--timeline-status-background', 'text' => '--timeline-status-text'] as $field => $property) {
    $value = $term->get('field_status_' . $field . '_color')->value;
    if ($value && preg_match('/^#[0-9a-fA-F]{6}$/', $value)) {
      $styles[] = $property . ': ' . $value;
    }
  }
  $variables['status_style'] = implode('; ', $styles);
  CacheableMetadata::createFromObject($term)->applyTo($variables['content']);
}

/**
 * Appetizer layout block preprocess.
 *
 * @param array $variables
 *   Template variables.
 */
function favrskov_preprocess_block__inline_block__appetizer(array &$variables) {
  /** @var \Drupal\block_content\Entity\BlockContent $block */
  $block = $variables['elements']['content']['#block_content'];
  $layout = $variables['elements']['content']['#layout'] ?? [];
  $layout_id = $layout['layout_id'] ?? '';
  $image_style = 'appetiser';

  if ($block->hasField('field_appetizer_image') && !$block->get('field_appetizer_image')->isEmpty()) {
    $media = $block->get('field_appetizer_image')->entity;

    if (!is_null($media)) {

      if ($block->hasField('field_appetizer_image') && !$block->get('field_appetizer_image')->isEmpty() && !is_null($block->get('field_appetizer_image')->entity)) {
        if ($layout_id === 'layout_onecol' && isset($layout['settings']['column_width']) && $layout['settings']['column_width'] === 'fullwidth') {
          $image_style = 'appetiser_wide';
          $variables['display_as_fullwidth'] = TRUE;
        }
        elseif ($layout_id === 'layout_onecol') {
          $image_style = 'full_width_16_9';
        }
        elseif ($layout_id === 'layout_twocol_section') {
          $image_style = '2_column';
        }
        elseif ($layout_id === 'layout_threecol_section') {
          $image_style = '3_column';
        }
        $variables['media_image'] = \Drupal::entityTypeManager()
          ->getViewBuilder('media')
          ->view($block->get('field_appetizer_image')->entity, $image_style);
        if (in_array($media->bundle(), ['remote_video', 'cdn_video'])) {
          $variables['media'] = \Drupal::entityTypeManager()
            ->getViewBuilder('media')
            ->view($block->get('field_appetizer_image')->entity, $image_style);
          $variables['is_video'] = TRUE;
        }
      }
    }
  }
}
