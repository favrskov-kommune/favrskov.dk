{{ attach_library('favrskov/search-toggle') }}

<button type="button" class="search-toggle js-search-toggle" aria-label="{{ 'Search'|t }}" aria-controls="js-search-overlay" aria-expanded="false">
  {% include '@particles/svg-icon/svg-icon.twig' with {
    'attributes': create_attribute().setAttribute('aria-hidden', 'true'),
    'svgIconName': 'search'
  } %}
  <span class="search-toggle__label">{{ 'Search'|t }}</span>
</button>
