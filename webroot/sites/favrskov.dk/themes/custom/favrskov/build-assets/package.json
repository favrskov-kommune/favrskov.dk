{
  "name": "premium-frontend",
  "description": "Premium frontend.",
  "type": "module",
  "config": {
    "CSS_BASE": "src/",
    "CSS_FILEMATCH": "'src/**/*.css'",
    "CSS_DIST": "dist/css",
    "WEBPACK_BASE": "src/",
    "WEBPACK_FILEMATCH": "src/**/*.js",
    "WEBPACK_DIST": "dist/js",
    "SPRITES_FILEMATCH": "assets/icons/**/**/*.svg",
    "SPRITES_DIST": "dist/icons/icons.svg",
    "IMAGES_FILEMATCH": "assets/images/**/*.{jpg,png,svg,gif}",
    "IMAGES_DIST": "dist/images",
    "FONTS_FILEMATCH": "assets/fonts/**/*",
    "FONTS_DIST": "dist/fonts",
    "CLEANUP_MATCH": "dist"
  },
  "scripts": {
    "cleanup": "node config/cleanup.js -i $npm_package_config_CLEANUP_MATCH",
    "build:prod": "npm-run-all -l cleanup build:css build:webpack build:sprites build:fonts build:assets",
    "build:dev": "npm-run-all -l cleanup build:css-dev build:webpack-dev build:sprites build:fonts build:images",
    "build:css": "cross-env NODE_ENV=production postcss $npm_package_config_CSS_FILEMATCH --dir $npm_package_config_CSS_DIST --base $npm_package_config_CSS_BASE --config config/postcss.config.cjs",
    "build:css-dev": "cross-env postcss $npm_package_config_CSS_FILEMATCH --dir $npm_package_config_CSS_DIST --base $npm_package_config_CSS_BASE --config config/postcss.config.cjs",
    "build:webpack": "fileMatch=$npm_package_config_WEBPACK_FILEMATCH webpack --config config/webpack.config.cjs --output-path $npm_package_config_WEBPACK_DIST --context $npm_package_config_WEBPACK_BASE --mode production",
    "build:webpack-dev": "fileMatch=$npm_package_config_WEBPACK_FILEMATCH webpack --config config/webpack.config.cjs --output-path $npm_package_config_WEBPACK_DIST --context $npm_package_config_WEBPACK_BASE --mode development",
    "build:fonts": "cross-env-shell copyfiles -u 2 \"$npm_package_config_FONTS_FILEMATCH\" \"$npm_package_config_FONTS_DIST\" -V",
    "build:sprites": "node config/sprite.js -i $npm_package_config_SPRITES_FILEMATCH -o $npm_package_config_SPRITES_DIST",
    "build:images": "node config/process-images.cjs -i $npm_package_config_IMAGES_FILEMATCH -o $npm_package_config_IMAGES_DIST",
    "build:svg": "node config/copy-svg.cjs -i $npm_package_config_IMAGES_FILEMATCH -o $npm_package_config_IMAGES_DIST",
    "build:assets": "npm-run-all build:svg build:images",
    "watch:css": "cross-env NODE_ENV=production postcss $npm_package_config_CSS_FILEMATCH --dir $npm_package_config_CSS_DIST --base $npm_package_config_CSS_BASE --config config/postcss.config.cjs --watch --verbose",
    "watch:css-dev": "cross-env postcss $npm_package_config_CSS_FILEMATCH --dir $npm_package_config_CSS_DIST --base $npm_package_config_CSS_BASE --config config/postcss.config.cjs --watch --verbose",
    "watch:webpack": "fileMatch=$npm_package_config_WEBPACK_FILEMATCH webpack --config config/webpack.config.cjs --output-path $npm_package_config_WEBPACK_DIST --context $npm_package_config_WEBPACK_BASE --mode production --watch",
    "watch:webpack-dev": "fileMatch=$npm_package_config_WEBPACK_FILEMATCH webpack --config config/webpack.config.cjs --output-path $npm_package_config_WEBPACK_DIST --context $npm_package_config_WEBPACK_BASE --mode development --watch"
  },
  "license": "MIT",
  "optionalDependencies": {
    "fsevents": "^2.3.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-object-assign": "^7.27.1",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.29.2",
    "babel-loader": "^10.1.1",
    "babel-polyfill": "^6.26.0",
    "chalk": "^5.6.2",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "cssnano": "^7.1.7",
    "del": "^8.0.1",
    "eslint": "^8.57.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "glob": "^13.0.6",
    "glob-watcher": "^6.0.0",
    "imagemin": "^9.0.1",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.12",
    "postcss-cli": "^11.0.1",
    "postcss-color-function": "^4.1.0",
    "postcss-custom-properties": "^15.0.1",
    "postcss-import": "^16.1.1",
    "postcss-loader": "^8.2.1",
    "postcss-nested": "^7.0.2",
    "postcss-preset-env": "^11.2.1",
    "postcss-reporter": "^7.1.0",
    "style-loader": "^4.0.0",
    "stylelint": "^17.9.1",
    "stylelint-config-standard": "^40.0.0",
    "svg-sprite": "^2.0.4",
    "terser-webpack-plugin": "^5.5.0",
    "uglify-js": "^3.19.3",
    "vue-loader": "^17.4.2",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^5.106.2",
    "webpack-bundle-analyzer": "^5.3.0",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "body-scroll-lock": "^3.1.5",
    "flickity": "^3.0.0",
    "flickity-as-nav-for": "^3.0.0",
    "flickity-fade": "^2.0.0",
    "get-video-id": "^4.2.0",
    "gsap": "^3.15.0",
    "hoverintent": "^2.2.1",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "lodash": "^4.18.1",
    "novicell-lazyload": "^3.0.6",
    "postcss-custom-media": "^12.0.1",
    "postcss-nested-import": "^1.3.0",
    "sharp": "^0.34.5",
    "vue": "^3.5.33"
  }
}
