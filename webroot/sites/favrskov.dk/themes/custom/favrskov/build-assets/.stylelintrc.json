{
  "extends": "stylelint-config-standard",
  "plugins": ["@stylistic/stylelint-plugin"],
  "ignoreFiles": [
    "**/node_modules/**",
    "**/dist/**"
  ],
  "rules": {
    "no-descending-specificity": null,
    "@stylistic/selector-max-empty-lines": 0,
    "alpha-value-notation": null,
    "color-function-alias-notation": null,
    "color-function-notation": null,
    "hue-degree-notation": null,
    "media-feature-range-notation": null,
    "selector-not-notation": null,
    "at-rule-empty-line-before": null,
    "rule-empty-line-before": null,
    "length-zero-no-unit": null,
    "property-no-vendor-prefix": [true, { "disableFix": true }],
    "selector-no-vendor-prefix": [true, { "disableFix": true }],
    "custom-property-pattern": "^[a-z][a-z0-9]*(?:--?[a-z0-9]+)*$",
    "number-max-precision": 8,
    "declaration-block-no-redundant-longhand-properties": null,
    "value-keyword-case": ["lower", { "ignoreKeywords": ["currentColor"] }],
    "block-no-empty": true,
    "color-no-invalid-hex": true,
    "selector-max-class": 4,
    "declaration-no-important": true,
    "unit-no-unknown": true,
    "at-rule-no-unknown": [true, { "ignoreAtRules": ["custom-media", "nested-import"] }],
    "selector-nested-pattern": "^([.]|&|img|figcaption|a|picture|li|ul|>|svg|form|input|iframe|div)",
    "selector-class-pattern": "^[a-zA-Z0-9]+(?:-[a-zA-Z0-9]+)*(?:__[a-zA-Z0-9]+(?:-[a-zA-Z0-9]+)*)?(?:--[a-zA-Z0-9]+(?:-[a-zA-Z0-9]+)*)?(?:\\[.+\\])?$",
    "property-no-unknown": [
      true,
      {
        "ignoreProperties": [
          "/tap-highlight-color/",
          "string"
        ]
      }
    ],
    "selector-max-id": 1,
    "unit-allowed-list": [
      "em",
      "rem",
      "%",
      "s",
      "px",
      "deg",
      "vh",
      "ms",
      "vw",
      "fr"
    ],
    "@stylistic/indentation": 2,
    "selector-pseudo-class-no-unknown": true,
    "@stylistic/max-empty-lines": [
      2,
      {
        "ignore": [
          "comments"
        ]
      }
    ]
  }
}
