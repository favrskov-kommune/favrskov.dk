+  /**
+   * Tests paragraph access when parent is a non-reusable block_content.
+   *
+   * Regression for #3090200: the bug manifests outside the Layout Builder
+   * rendering pipeline — e.g. REST, JSON:API, Views, or programmatic
+   * $paragraph->access() calls. In those contexts the block_content entity
+   * is loaded from storage with no access dependency set. The old code called
+   * $block->access('view') unconditionally, which
+   * BlockContentAccessControlHandler returns as forbidden for all accounts
+   * when no dependency is set ("Non-reusable blocks must set an access
+   * dependency for access control."). This caused published paragraphs inside
+   * Layout Builder inline blocks to be inaccessible outside the render path.
+   *
+   * The fix detects a non-reusable block_content host and skips the parent
+   * access check, delegating solely to the paragraph's own published status.
+   *
+   * @covers ::checkAccess
+   */
+  public function testCheckAccessNonReusableBlockContentParent(): void {
+    $this->setUpAccessFixtures();
+    $this->installEntitySchema('block_content');
+
+    BlockContentType::create([
+      'id' => 'inline_block_type',
+      'label' => 'Inline block type',
+      'revision' => TRUE,
+    ])->save();
+    FieldStorageConfig::create([
+      'field_name' => 'field_paragraphs',
+      'entity_type' => 'block_content',
+      'type' => 'entity_reference_revisions',
+      'cardinality' => FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED,
+      'settings' => ['target_type' => 'paragraph'],
+    ])->save();
+    FieldConfig::create([
+      'field_name' => 'field_paragraphs',
+      'entity_type' => 'block_content',
+      'bundle' => 'inline_block_type',
+      'settings' => [
+        'handler' => 'default:paragraph',
+        'handler_settings' => ['target_bundles' => NULL],
+      ],
+    ])->save();
+
+    $anonymous = $this->createUser(['access content']);
+
+    $paragraph = Paragraph::create([
+      'type' => 'text_paragraph',
+      'field_text' => 'inline content',
+      'status' => TRUE,
+    ]);
+    $paragraph->save();
+
+    // Create the block as non-reusable — exactly as Layout Builder does for
+    // inline blocks. No access dependency is set, simulating what happens
+    // outside the Layout Builder rendering context (REST, JSON:API, Views,
+    // programmatic access checks).
+    $block = BlockContent::create([
+      'info' => 'LB inline block',
+      'type' => 'inline_block_type',
+      'reusable' => FALSE,
+      'field_paragraphs' => [$paragraph],
+    ]);
+    $block->save();
+
+    $paragraph = $this->reload($paragraph);
+
+    // Sanity check: the block itself is forbidden outside LB context because
+    // no access dependency has been set.
+    $this->assertTrue($block->access('view', $anonymous) === FALSE);
+
+    // The paragraph must be viewable. The fix skips the parent access check
+    // for non-reusable block_content and relies on the paragraph's own
+    // published status. Without the fix, the forbidden block access propagates
+    // to the paragraph and this assertion fails.
+    $this->assertTrue($paragraph->access('view', $anonymous));
+
+    // An unpublished paragraph inside the same non-reusable block must still
+    // be denied — the paragraph's own status governs.
+    $unpublished = Paragraph::create([
+      'type' => 'text_paragraph',
+      'field_text' => 'hidden content',
+      'status' => FALSE,
+    ]);
+    $unpublished->save();
+    $block->set('field_paragraphs', [$paragraph, $unpublished]);
+    $block->save();
+    $unpublished = $this->reload($unpublished);
+    $this->assertFalse($unpublished->access('view', $anonymous));
+  }
+
