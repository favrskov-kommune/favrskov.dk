+   */
+  protected function parentReferencesChildRevision(EntityInterface $parent, $field_name, $child_revision_id) {
+    foreach ($parent->get($field_name) as $item) {
+      if ((int) $item->target_revision_id === (int) $child_revision_id) {
+        return TRUE;
+      }
+    }
+    return FALSE;
+  }
