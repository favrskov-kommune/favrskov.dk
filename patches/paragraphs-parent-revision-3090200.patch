+  /**
+   * Tests that an inaccessible default revision does not mask the fix.
+   *
+   * Issue #3090200's regression: the access check must be made against the
+   * revision that actually references the paragraph, *instead of* (not in
+   * addition to) the default revision. Here a historical paragraph revision
+   * belongs to a published node revision (rev1), but a later save makes the
+   * node's default revision unpublished (rev2). A user with only
+   * 'access content' must still be able to view the historical paragraph,
+   * because the revision that references it is published.
+   *
+   * If checkAccess() andIf()-ed the default (unpublished) revision's access on
+   * top of the resolved revision's access, the default revision would mask the
+   * correct decision and deny view -- reproducing the original bug.
+   *
+   * @covers ::checkAccess
+   */
+  public function testCheckAccessDefaultRevisionDoesNotMaskResolvedRevision(): void {
+    $this->setUpAccessFixtures();
+    $viewer = $this->createUser(['access content']);
+
+    // rev1: published, references the first paragraph revision.
+    $paragraph = Paragraph::create([
+      'type' => 'text_paragraph',
+      'field_text' => 'v1',
+    ]);
+    $paragraph->save();
+    $node = Node::create([
+      'title' => 'Host',
+      'type' => 'paragraphed_test',
+      'status' => 1,
+      'field_paragraphs' => [$paragraph],
+    ]);
+    $node->save();
+    $first_paragraph_revision_id = $paragraph->getRevisionId();
+    $first_node_revision_id = $node->getRevisionId();
+
+    // rev2 (new default): unpublished, references a new paragraph revision.
+    $paragraph = $this->reload($paragraph);
+    $paragraph->set('field_text', 'v2');
+    $paragraph->setNewRevision(TRUE);
+    $paragraph->save();
+    $node = $this->reload($node);
+    $node->set('field_paragraphs', [$paragraph]);
+    $node->set('status', 0);
+    $node->setNewRevision(TRUE);
+    $node->save();
+
+    // The default revision is now the unpublished rev2 -- the trap.
+    $default_node = \Drupal::entityTypeManager()
+      ->getStorage('node')
+      ->loadUnchanged($node->id());
+    $this->assertFalse((bool) $default_node->isPublished());
+
+    $old_paragraph = \Drupal::entityTypeManager()
+      ->getStorage('paragraph')
+      ->loadRevision($first_paragraph_revision_id);
+
+    // The resolver picks the published rev1...
+    $handler = \Drupal::entityTypeManager()->getAccessControlHandler('paragraph');
+    $reflection = new \ReflectionMethod($handler, 'resolveAccessHost');
+    $reflection->setAccessible(TRUE);
+    $host = $reflection->invoke($handler, $old_paragraph);
+    $this->assertSame($first_node_revision_id, $host->getRevisionId());
+
+    // ...and that decision must reach callers: viewing the historical
+    // paragraph is allowed because its referencing revision is published,
+    // even though the default revision is not.
+    $this->assertTrue($old_paragraph->access('view', $viewer));
+  }
+
+  /**
+   * Tests that revisionable non-node hosts (block_content) are resolved too.
+   *
+   * The bug report explicitly calls out block_content + Layout Builder. The
+   * fix should be host-agnostic; this test confirms loadReferencingRevision
+   * works for a non-node revisionable host.
+   *
+   * @covers ::resolveAccessHost
+   * @covers ::loadReferencingRevision
+   */
+  public function testCheckAccessUsesBlockContentRevision(): void {
+    $this->setUpAccessFixtures();
+    $this->installEntitySchema('block_content');
+
+    BlockContentType::create([
+      'id' => 'basic',
+      'label' => 'basic',
+      'revision' => TRUE,
+    ])->save();
+    FieldStorageConfig::create([
+      'field_name' => 'field_paragraphs',
+      'entity_type' => 'block_content',
+      'type' => 'entity_reference_revisions',
+      'cardinality' => FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED,
+      'settings' => ['target_type' => 'paragraph'],
+    ])->save();
+    FieldConfig::create([
+      'field_name' => 'field_paragraphs',
+      'entity_type' => 'block_content',
+      'bundle' => 'basic',
+      'settings' => [
+        'handler' => 'default:paragraph',
+        'handler_settings' => ['target_bundles' => NULL],
+      ],
+    ])->save();
+
+    $paragraph = Paragraph::create([
+      'type' => 'text_paragraph',
+      'field_text' => 'v1',
+    ]);
+    $paragraph->save();
+    $block = BlockContent::create([
+      'info' => 'Host block',
+      'type' => 'basic',
+      'field_paragraphs' => [$paragraph],
+    ]);
+    $block->save();
+    $first_block_revision_id = $block->getRevisionId();
+    $first_paragraph_revision_id = $paragraph->getRevisionId();
+
+    // New paragraph revision attached to a new block revision.
+    $paragraph = $this->reload($paragraph);
+    $paragraph->set('field_text', 'v2');
+    $paragraph->setNewRevision(TRUE);
+    $paragraph->save();
+    $block = $this->reload($block);
+    $block->set('field_paragraphs', [$paragraph]);
+    $block->setNewRevision(TRUE);
+    $block->save();
+    $second_block_revision_id = $block->getRevisionId();
+    $this->assertNotSame($first_block_revision_id, $second_block_revision_id);
+
+    $handler = \Drupal::entityTypeManager()->getAccessControlHandler('paragraph');
+    $reflection = new \ReflectionMethod($handler, 'resolveAccessHost');
+    $reflection->setAccessible(TRUE);
+    $old_paragraph = \Drupal::entityTypeManager()
+      ->getStorage('paragraph')
+      ->loadRevision($first_paragraph_revision_id);
+
+    $host = $reflection->invoke($handler, $old_paragraph);
+    $this->assertNotNull($host);
+    $this->assertSame('block_content', $host->getEntityTypeId());
+    $this->assertSame($first_block_revision_id, $host->getRevisionId());
+  }
+
+  /**
+   * Reloads an entity from storage to pick up parent references on save.
+   */
+  protected function reload($entity) {
+    return \Drupal::entityTypeManager()
+      ->getStorage($entity->getEntityTypeId())
+      ->loadUnchanged($entity->id());
+  }
