{
    "name": "novicell/drupal-premium",
    "description": "Novicell Drupal Premium project",
    "type": "project",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://packages.drupal.dk/php/",
            "exclude": [
                "novicell/drupal-premium-theme",
                "novicell/styles"
            ]
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "bower-asset/jquery-simple-color": "^1.2",
        "bower-asset/spectrum": "^1.8",
        "composer/installers": "^1.2",
        "cweagans/composer-patches": "^1.6.5",
        "drupal/admin_toolbar": "^3.0",
        "drupal/allowed_formats": "^3.0",
        "drupal/atoms": "^1.0.1",
        "drupal/autosave_form": "^1.0",
        "drupal/color_field": "^3.0",
        "drupal/components": "^3.0",
        "drupal/config_filter": "^2.6",
        "drupal/config_ignore": "^3.1",
        "drupal/config_split": "^2.0",
        "drupal/core-composer-scaffold": "^11.4.9",
        "drupal/core-project-message": "^11.4.9",
        "drupal/core-recommended": "^11.4.9",
        "drupal/core-vendor-hardening": "^11.4.9",
        "drupal/editor_advanced_link": "^2.2",
        "drupal/entity_clone": "^2.0",
        "drupal/entity_hierarchy": "^3.3",
        "drupal/entity_usage": "^2.0-beta3",
        "drupal/field_group": "^4.0",
        "drupal/focal_point": "^2.0",
        "drupal/gin": "^5.0",
        "drupal/gin_lb": "^3.0@beta",
        "drupal/gin_toolbar": "^3.0",
        "drupal/honeypot": "^2.2",
        "drupal/hreflang": "^1.0",
        "drupal/imageapi_optimize": "^4.2",
        "drupal/inline_block_title_automatic": "^2.0",
        "drupal/layout_builder_at": "^3.0",
        "drupal/layout_builder_modal": "^2.0",
        "drupal/layout_builder_reorder": "^1.0",
        "drupal/layout_builder_restrictions": "^3.0",
        "drupal/linkit": "^7.0",
        "drupal/mailsystem": "^4.5",
        "drupal/media_library_bulk_upload": "^1.0.4",
        "drupal/metatag": "^2.0",
        "drupal/moderated_content_bulk_publish": "^2.0",
        "drupal/noreferrer": "^2.0",
        "drupal/paragraphs": "^1.23",
        "drupal/paragraphs_asymmetric_translation_widgets": "^1.0",
        "drupal/path_redirect_import": "^2.0",
        "drupal/pathauto": "^1.0",
        "drupal/rdf": "^4.0",
        "drupal/redirect": "^1.0",
        "drupal/redis": "^1.8",
        "drupal/responsive_table_filter": "^2.0",
        "drupal/role_delegation": "^1.6",
        "drupal/scheduled_transitions": "^2.3",
        "drupal/search_api": "^1.0",
        "drupal/search_api_exclude_entity": "^3.0",
        "drupal/search_api_page": "^1.0",
        "drupal/simple_sitemap": "^4.1",
        "drupal/siteimprove": "^3.0",
        "drupal/stable": "^2.0",
        "drupal/symfony_mailer": "^1.4",
        "drupal/token": "^1.13",
        "drupal/view_unpublished": "^1.0",
        "drupal/webform": "^6.3",
        "drupal/webp": "^1.0.0-beta5",
        "drush/drush": "^13.0",
        "novicell/content_hierarchy": "^1.0",
        "novicell/drupal-premium-theme": "^2.1.1",
        "novicell/dynamic_key_value": "^1.2",
        "novicell/ie_warning": "^1.0",
        "novicell/media_icons": "^1.0",
        "novicell/premium_core": "^1.0",
        "novicell/premium_gin": "^0.1.0",
        "novicell/premium_profile": "^11.0",
        "novicell/premium_search": "^1.0",
        "novicell/premium_tools": "^1.0",
        "novicell/status_feed": "^1.3.1",
        "novicell/styles": "^1.2.2",
        "npm-asset/js-cookie": "^3.0.5",
        "oomphinc/composer-installers-extender": "^2.0",
        "vlucas/phpdotenv": "^5.3",
        "wikimedia/composer-merge-plugin": "^2.0"
    },
    "require-dev": {
        "deployer/deployer": "^7.3",
        "drupal/devel": "^5.1",
        "kint-php/kint": "^5.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform-check": false,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-vendor-hardening": true,
            "oomphinc/composer-installers-extender": true,
            "wikimedia/composer-merge-plugin": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "classmap": [
            "scripts/composer/ScriptHandler.php"
        ]
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "drupal-scaffold": {
            "allowed-packages": [
                "drupal/core"
            ],
            "locations": {
                "web-root": "webroot/"
            },
            "file-mapping": {
                "[web-root]/robots.txt": {
                    "append": "assets/robots-additions.txt"
                },
                "[web-root]/sites/development.services.yml": {
                    "mode": "replace",
                    "path": "assets/development.services.yml",
                    "overwrite": false
                }
            }
        },
        "installer-paths": {
            "webroot/core": [
                "type:drupal-core"
            ],
            "webroot/libraries/{$name}": [
                "type:drupal-library",
                "type:npm-asset",
                "type:bower-asset"
            ],
            "webroot/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "webroot/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "webroot/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "webroot/drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "webroot/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "webroot/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "installer-types": [
            "npm-asset",
            "bower-asset"
        ],
        "merge-plugin": {
            "include": [
                "webroot/modules/contrib/webform/composer.libraries.json"
            ]
        },
        "patches": {
            "drupal/core": {
                "(#3080606) [PP-1] Reorder Layout Builder sections": "https://www.drupal.org/files/issues/2025-09-26/3080606-128-11.1.x.patch"
            },
            "drupal/autosave_form": {
                "(#3355495) PHP 8.2 deprecation issue with AutosaveFormBuilder": "https://www.drupal.org/files/issues/2023-04-20/autosave_form-dynamic-property-deprecation.patch"
            },
            "drupal/entity_hierarchy": {
                "(#2862044) Default weight value is not saved, unless default entity is not specified too": "https://www.drupal.org/files/issues/2023-10-10/entity_hierarchy_2862044_default-weight_22.patch"
            },
            "drupal/paragraphs": {
                "(#3090200) Resolve the correct parent revision for Paragraphs access checks": "patches/paragraphs-parent-revision-3090200.patch",
                "(#2901390) Integrity constraint violation: 1048 Column 'langcode' cannot be null": "https://www.drupal.org/files/issues/2023-07-20/2901390-9-109.patch"
            }
        }
    }
}
